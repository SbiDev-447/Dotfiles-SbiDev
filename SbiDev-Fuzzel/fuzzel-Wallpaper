# ~/.local/bin/fuzzel-Wallpaper

set -euo pipefail

# ==================== CONFIGURACIÓN ====================
WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Imágenes/Wallpapers}"
RENDER_MODE="${WALLPAPER_RENDER_MODE:-stretch}"

# Intentar con tilde y sin tilde (español)
if [ ! -d "$WALLPAPER_DIR" ]; then
  WALLPAPER_DIR="$HOME/Imagenes/Wallpapers"
fi

if [ ! -d "$WALLPAPER_DIR" ]; then
  WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
fi

if [ ! -d "$WALLPAPER_DIR" ]; then
  notify-send "Error" "No se encuentra la carpeta de wallpapers"
  exit 1
fi

# ==================== SELECCIÓN ====================

# Cada línea que recibe fuzzel lleva dos columnas separadas por TAB:
#   columna 1: nombre visible (lo que se ve en el menú)
#   columna 2: ruta absoluta  (lo que devuelve fuzzel al elegir)
# Con --with-nth=1 se muestra solo la primera y con --accept-nth=2 fuzzel
# devuelve la segunda, así que no hay que reconstruir nada: los espacios, los
# acentos y las subcarpetas dejan de importar.
select_image() {
  local file rel folder base

  while IFS= read -r -d '' file; do
    rel="${file#"$WALLPAPER_DIR"/}"
    folder="$(dirname "$rel")"
    base="$(basename "$rel")"

    if [ "$folder" = "." ]; then
      printf '%s\t%s\n' "$base" "$file"
    else
      printf '[%s] %s\t%s\n' "$folder" "$base" "$file"
    fi
  done < <(find "$WALLPAPER_DIR" -type f -iname '*.webp' -print0) |
    fuzzel --dmenu \
      -p "Fondo: " \
      --lines=15 \
      --width=70 \
      --font "IosevkaTerm NF:size=14" \
      --with-nth=1 \
      --accept-nth=2
}

# ==================== CAMBIO DE WALLPAPER ====================
change_wallpaper() {
  local full_path="$1"

  # Matar proceso anterior
  pkill -u "$USER" -x swaybg 2>/dev/null || true

  # Dormir solo 20 milisegundos (prácticamente instantáneo)
  sleep 0.01

  # Lanzar nuevo wallpaper
  nohup swaybg -i "$full_path" -m "$RENDER_MODE" >/dev/null 2>&1 &
  disown
}

# ==================== EJECUCIÓN PRINCIPAL ====================

# Elegir imagen. fuzzel devuelve error al cancelar con Esc: en ese caso no hay
# nada que validar ni nada que lanzar, así que se sale limpiamente.
selected="$(select_image)" || selected=""
[ -z "$selected" ] && exit 0

# Verificar que la imagen existe, es legible y no está vacía
if [ ! -f "$selected" ] || [ ! -r "$selected" ] || [ ! -s "$selected" ]; then
  notify-send "Error" "La imagen no es válida o está corrupta"
  exit 1
fi

change_wallpaper "$selected"
