# CLI para convertir recursivamente imágenes a WebP
# Uso: convertMyBackgrounds [directorio]
# Si no se especifica directorio, usa el directorio actual.
# Pregunta si modificar calidad (por defecto: 85).

set -euo pipefail

# Usar argumento o directorio actual
TARGET_DIR="${1:-$(pwd)}"

if [ ! -d "$TARGET_DIR" ]; then
  echo "Error: '$TARGET_DIR' no es un directorio válido."
  exit 1
fi

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Calidad de conversión
DEFAULT_QUALITY=85
QUALITY=$DEFAULT_QUALITY

echo ""
echo -e "${YELLOW}¿Deseas modificar la calidad de conversión? (actual: $DEFAULT_QUALITY)${NC}"
read -p "(s/N): " -n 1 -r
echo ""

if [[ $REPLY =~ ^[Ss]$ ]]; then
  while true; do
    read -p "Calidad (1-100, recomendado 75-85): " INPUT_QUALITY
    if [[ "$INPUT_QUALITY" =~ ^[0-9]+$ ]] && [ "$INPUT_QUALITY" -ge 1 ] && [ "$INPUT_QUALITY" -le 100 ]; then
      QUALITY=$INPUT_QUALITY
      break
    else
      echo -e "${RED}Valor no válido. Introduce un número entre 1 y 100.${NC}"
    fi
  done
fi

ORIGINAL_FILES=()

# Verificar que ImageMagick está instalado
if ! command -v convert &>/dev/null; then
  echo -e "${RED}Error: ImageMagick no está instalado.${NC}"
  echo "Instálalo con: sudo apt install imagemagick  (o el gestor de paquetes de tu distro)"
  exit 1
fi

# Conversiones simultáneas: una por núcleo. Se puede forzar con JOBS=1 convertMyBackgrounds ...
JOBS="${JOBS:-$(nproc)}"

# Los workers son subshells: no pueden tocar los contadores del padre, así que
# cada uno anota su resultado y al final se cuentan los registros.
SCRATCH_DIR=$(mktemp -d)
CONVERTED_LIST="$SCRATCH_DIR/converted"
FAILED_LIST="$SCRATCH_DIR/failed"
SKIPPED_LIST="$SCRATCH_DIR/skipped"
trap 'rm -rf "$SCRATCH_DIR"' EXIT

echo -e "${GREEN}=== CONVERSOR RECURSIVO A WEBP ===${NC}"
echo "Directorio base: $TARGET_DIR"
echo "Calidad de conversión: $QUALITY"
echo "Conversiones simultáneas: $JOBS"
echo "Buscando imágenes... (esto puede tomar un momento)"
echo ""

# Función para convertir una imagen (se ejecuta en paralelo, ver xargs abajo)
convert_image() {
  local input_file="$1"
  local output_file="${input_file%.*}.webp"

  # Verificar si ya existe el WebP (para no reconvertir)
  if [ -f "$output_file" ]; then
    echo -e "${YELLOW}⚠  Saltando: $input_file (el WebP ya existe)${NC}"
    printf '%s\0' "$input_file" >> "$SKIPPED_LIST"
    return 0
  fi

  # Intentar convertir con la calidad seleccionada
  if convert "$input_file" -quality "$QUALITY" -strip "$output_file" 2>/dev/null; then
    echo -e "${GREEN}✓  Convertido: $output_file${NC}"
    printf '%s\0' "$input_file" >> "$CONVERTED_LIST"
  else
    echo -e "${RED}✗  Falló: $input_file${NC}"
    printf '%s\0' "$input_file" >> "$FAILED_LIST"
  fi
  return 0
}
export -f convert_image
export QUALITY CONVERTED_LIST FAILED_LIST SKIPPED_LIST RED GREEN YELLOW NC

# Buscar y procesar archivos de imagen
# Usamos find para buscar recursivamente todas las imágenes comunes.
# El bucle descarta las entradas que generarían el mismo .webp: en paralelo dos
# conversiones escribirían el mismo fichero a la vez y luego se borrarían los dos
# originales, quedando uno solo. Se conserva la primera, igual que en serie.
echo "Procesando archivos..."
declare -A seen_outputs=()
find "$TARGET_DIR" -type f \( \
  -iname "*.jpg" -o \
  -iname "*.jpeg" -o \
  -iname "*.png" -o \
  -iname "*.gif" -o \
  -iname "*.bmp" -o \
  -iname "*.tiff" -o \
  -iname "*.tif" -o \
  -iname "*.avif" -o \
  -iname "*.heic" -o \
  -iname "*.heif" \) -print0 |
  while IFS= read -r -d '' file; do
    output_key="${file%.*}"
    if [ -z "${seen_outputs[$output_key]+x}" ]; then
      seen_outputs["$output_key"]=1
      printf '%s\0' "$file"
    else
      # A stderr: lo que salga por stdout acabaría siendo una entrada de xargs
      echo -e "${YELLOW}⚠  Saltando: $file (otro archivo produce el mismo WebP)${NC}" >&2
      printf '%s\0' "$file" >> "$SKIPPED_LIST"
    fi
  done |
  xargs -0 -r -n1 -P"$JOBS" bash -c 'convert_image "$1"' _

count_records() {
  if [ -s "$1" ]; then
    tr -cd '\0' < "$1" | wc -c
  else
    echo 0
  fi
}

CONVERTED_COUNT=$(count_records "$CONVERTED_LIST")
FAILED_COUNT=$(count_records "$FAILED_LIST")
SKIPPED_COUNT=$(count_records "$SKIPPED_LIST")
TOTAL_IMAGES=$((CONVERTED_COUNT + FAILED_COUNT + SKIPPED_COUNT))

if [ -s "$CONVERTED_LIST" ]; then
  mapfile -d '' -t ORIGINAL_FILES < "$CONVERTED_LIST"
fi

echo ""
echo -e "${GREEN}=== RESUMEN ===${NC}"
echo "Total de imágenes encontradas: $TOTAL_IMAGES"
echo -e "${GREEN}Conversiones exitosas: $CONVERTED_COUNT${NC}"
echo -e "${YELLOW}Saltadas (el WebP ya existía): $SKIPPED_COUNT${NC}"
echo -e "${RED}Fallos: $FAILED_COUNT${NC}"

# Si no hay archivos para eliminar, salir
if [ ${#ORIGINAL_FILES[@]} -eq 0 ]; then
  echo "No hay archivos originales que eliminar."
  exit 0
fi

# Preguntar si quiere eliminar los archivos originales
echo ""
echo -e "${YELLOW}¿Deseas eliminar los archivos originales (no WebP) que se convirtieron?${NC}"
echo "Archivos que se eliminarían:"
printf "  - %s\n" "${ORIGINAL_FILES[@]}"
echo ""
read -p "¿Eliminar estos archivos? (s/N): " -n 1 -r
echo ""

if [[ $REPLY =~ ^[Ss]$ ]]; then
  echo "Eliminando archivos originales..."
  DELETED=0
  for file in "${ORIGINAL_FILES[@]}"; do
    if [ -f "$file" ]; then
      rm "$file" && DELETED=$((DELETED + 1))
    fi
  done
  echo -e "${GREEN}Eliminados $DELETED archivos originales.${NC}"
else
  echo "No se eliminaron archivos. Los originales permanecen."
fi

echo ""
echo -e "${GREEN}¡Proceso completado!${NC}"
