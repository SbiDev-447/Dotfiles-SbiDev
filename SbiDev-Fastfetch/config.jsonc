{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$HOME/.config/fastfetch/loto.png",
    "color": {
      "1": "black",
      "2": "red",
      "3": "green",
      "4": "yellow",
      "5": "blue",
      "6": "#A245DE",
      "7": "cyan",
      "8": "#ffffff",
      "9": "#FB607F",
    },
    "padding": {
      "right": 2,
      "left": 1,
      "top": 1,
      "bottom": 1,
    },
  },
  "display": {
    "separator": "---",
    "key": {
      "width": 8,
    },
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "#FB607F",
    },
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#A245DE",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#A245DE",
    },
    {
      "type": "host",
      "format": "{1}",
      "key": "Host",
      "keyColor": "#A245DE",
    },
    {
      "type": "bios",
      "key": "BIOS",
      "keyColor": "#A245DE",
    },
    "break",
    "break",
    {
      "type": "de",
      "key": "DE",
      "keyColor": "34",
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "34",
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "34",
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "34",
    },
    {
      "type": "packages",
      "format": "{dpkg} apt",
      "key": "Pkgs",
      "keyColor": "36",
    },
    {
      "type": "packages",
      "format": "{nix-user} nix",
      "key": "Pkgs",
      "keyColor": "36",
    },
    "break",
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "Uptime",
      "keyColor": "32",
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "32",
      "format": "{1} ({3}) @ {7}",
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "32",
      "format": "{2}",
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "32",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "32",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "battery",
      "key": "Bat",
      "keyColor": "32",
      "format": "{1} {3} ({4})",
    },
    "break",
    "colors",
  ],
}
