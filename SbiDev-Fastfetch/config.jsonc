{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/logoSbiDev.txt",
    "color": {
      "1": "black",
      "2": "red",
      "3": "green",
      "4": "yellow",
      "5": "blue",
      "6": "#A245DE",
      "7": "cyan",
      "8": "#ffffff",
    },
    "padding": {
      "right": 2,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    "title",
    {
      "type": "os",
      "key": "OS    ",
      "keyColor": "31",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "32",
    },
    {
      "type": "host",
      "format": "{1}",
      "key": "Host  ",
      "keyColor": "33",
    },
    {
      "type": "terminal",
      "key": "Term  ",
      "keyColor": "34",
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "34",
    },
    {
      "type": "de",
      "key": "DE    ",
      "keyColor": "34",
    },
    {
      "type": "wm",
      "key": "WM    ",
      "keyColor": "34",
    },
    {
      "type": "packages",
      "format": "{} (apt)",
      "key": "Pkgs  ",
      "keyColor": "35",
    },
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "Uptime",
      "keyColor": "36",
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      "keyColor": "37",
      "format": "{1} ({3}) @ {7}GHz",
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "keyColor": "37",
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "37",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "disk",
      "key": "Disk  ",
      "keyColor": "37",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "battery",
      "key": "Bat   ",
      "keyColor": "37",
      "format": "{1} {2} ({3})",
    },
    "break",
    "colors",
  ],
}