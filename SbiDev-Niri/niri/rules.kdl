// ============================================================================
//                         REGLAS DE VENTANAS
// ============================================================================

// -- Esquinas redondeadas (global) --
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// -- Qalculate! (Calculadora) --
window-rule {
    match app-id=r#"^qalculate-gtk$"#
    open-floating true
    open-focused true
    default-column-width { fixed 800; }
    default-window-height { fixed 750; }
}

// -- Diálogos GTK (Abrir/Salvar) --
window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#
    default-column-width { fixed 900; }
    default-window-height { fixed 900; }
    open-floating true
    open-focused true
}

// -- Pavucontrol (Audio) --
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    default-column-width { fixed 950; }
    default-window-height { fixed 700; }
    open-floating true
    open-focused true
}

// -- Blueman (Bluetooth) --
window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    default-column-width { fixed 745; }
    default-window-height { fixed 745; }
    open-focused true
}

// -- Thunar: diálogos de propiedades --
window-rule {
    match app-id=r#"^thunar$"# title="^Properties$"
    match app-id=r#"^thunar$"# title="^Compress$"
    match app-id=r#"^thunar$"# title="^Rename$"
    match app-id=r#"^thunar$"# title="^Bulk Rename$"
    open-floating true
}

// -- Thunar: progreso de copiar/mover --
window-rule {
    match app-id=r#"^thunar$"# title="^File Operation Progress$"
    open-floating true
    default-column-width { proportion 0.4; }
}

// -- Picture-in-Picture (navegadores) --
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="librewolf$" title="^Picture-in-Picture$"
    match app-id="org.mozilla.firefox" title="^Picture-in-Picture$"
    match app-id="org.librewolf.LibreWolf" title="^Picture-in-Picture$"
    match app-id="com.github.Eloston.UngoogledChromium" title="^Picture-in-Picture$"
    match app-id="org.chromium.Chromium" title="^Picture-in-Picture$"
    match title="^LibreWolf - Seleccione un perfil$"
    match title="LibreWolf - Choose a profile"
    match title="^Catálogo$"
    open-floating true
    open-focused true
}

// -- Privacidad: bloquear capturas de KeePassXC --
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// -- Diálogos de impresión --
window-rule {
    match title="^Print$"
    match title="^Imprimir$"
    open-floating true
    open-focused true
}

