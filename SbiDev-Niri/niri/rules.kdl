// ██     ██ ██ ███    ██ ██████   ██████  ██     ██   ██████  ██    ██ ██      ███████ ███████
// ██     ██ ██ ████   ██ ██   ██ ██    ██ ██     ██   ██   ██ ██    ██ ██      ██      ██
// ██  █  ██ ██ ██ ██  ██ ██   ██ ██    ██ ██  █  ██   ██████  ██    ██ ██      █████   ███████
// ██ ███ ██ ██ ██  ██ ██ ██   ██ ██    ██ ██ ███ ██   ██   ██ ██    ██ ██      ██           ██
//  ███ ███  ██ ██   ████ ██████   ██████   ███ ███    ██   ██  ██████  ███████ ███████ ███████

// -- Global: esquinas redondeadas --
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// -- Alacritty --
window-rule {
    match app-id="Alacritty"
    default-column-width { fixed 1270; }
    default-window-height { fixed 1042; }
}

// -- Qalculate! --
window-rule {
    match app-id=r#"^qalculate-gtk$"#
    open-floating true
    open-focused true
    default-column-width { fixed 800; }
    default-window-height { fixed 750; }
}

// -- Diálogos GTK (Abrir/Salvar) --
window-rule {
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
    open-focused true
    default-column-width { fixed 900; }
    default-window-height { fixed 900; }
}

// -- Pavucontrol --
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    open-focused true
    default-column-width { fixed 950; }
    default-window-height { fixed 700; }
}

// -- Blueman --
window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    open-focused true
    default-column-width { fixed 745; }
    default-window-height { fixed 745; }
}

// -- Thunar: diálogos --
window-rule {
    match app-id=r#"^thunar$"# title="^Properties$"
    match app-id=r#"^thunar$"# title="^Compress$"
    match app-id=r#"^thunar$"# title="^Rename$"
    match app-id=r#"^thunar$"# title="^Bulk Rename$"
    open-floating true
    open-focused true
}

// -- Thunar: progreso de operaciones --
window-rule {
    match app-id=r#"^thunar$"# title="^File Operation Progress$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.4; }
}

// -- Diálogos de impresión --
window-rule {
    match title="^Print$"
    match title="^Imprimir$"
    open-floating true
    open-focused true
}

// -- Picture-in-Picture (navegadores) --
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="librewolf$" title="^Picture-in-Picture$"
    match app-id="org.mozilla.firefox" title="^Picture-in-Picture$"
    match app-id="org.librewolf.LibreWolf" title="^Picture-in-Picture$"
    match app-id="com.github.Eloston.UngoogledChromium" title="^Picture-in-Picture$"
    match app-id="org.chromium.Chromium" title="^Picture-in-Picture$"
    open-floating true
    open-focused true
}

// -- Selectores de perfil de LibreWolf --
window-rule {
    match app-id=r#"librewolf"# title="^LibreWolf - Seleccione un perfil$"
    match app-id=r#"librewolf"# title="LibreWolf - Choose a profile"
    open-floating true
    open-focused true
}

window-rule {
    match app-id=r#"librewolf"# title="^Catálogo"
    open-floating true
    open-focused true
}

// -- KeePassXC: bloquear capturas --
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// -- Obsidian: ventana principal --
window-rule {
    match app-id=r#"md\.obsidian\.Obsidian"#
    open-focused true
    open-maximized true
}

// -- Obsidian: preferencias --
window-rule {
    match app-id=r#"md\.obsidian\.Obsidian"# title="^Preferencias - .*"
    open-floating true
    open-focused true
    default-column-width { fixed 900; }
    default-window-height { fixed 900; }
}

// -- Obsidian: temas/plugins --
window-rule {
  match app-id=r#"md\.obsidian\.Obsidian"# title="^Temas de la comunidad - .*"
  open-focused true
  open-floating true
  default-column-width { fixed 900;}
  default-window-height { fixed 900; }
}
